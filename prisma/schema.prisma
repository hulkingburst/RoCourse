generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  name             String
  handle           String?            @unique
  passwordHash     String
  createdAt        DateTime           @default(now())
  progress         ProgressProfile?
  completions      CourseCompletion[]
  questions        Question[]
  answers          QuestionAnswer[]
  weeklyXp         WeeklyXp[]
  weeklyFirsts     WeeklyFirst[]
  notifications    Notification[]
  feedbackTickets  FeedbackTicket[]
}

model ProgressProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}

model CourseCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  title       String
  completedAt DateTime @default(now())

  @@unique([userId, courseId])
}

model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// Generic sliding-window rate limits for non-auth endpoints (feedback,
// resource submissions/uploads, Q&A writes) so they're shared across
// instances instead of per-process in-memory maps.
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

model Question {
  id         String           @id @default(cuid())
  authorId   String
  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  body       String
  lessonSlug String?
  solved     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  answers    QuestionAnswer[]

  @@index([createdAt])
}

model QuestionAnswer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([questionId, createdAt])
}

// Weekly XP leaderboard rows. Signed-in users are written when their progress
// syncs; guests (no account) write their own row through /api/guest-xp under a
// client-generated anonymous id and a self-chosen display name. `name` is a
// denormalized display name (account name for users) so rows survive renames.
model WeeklyXp {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?
  name      String
  week      String // Monday YYYY-MM-DD
  xp        Int
  updatedAt DateTime @updatedAt

  @@unique([week, userId])
  @@unique([week, guestId])
  @@index([week, xp])
  @@index([userId])
}

// Permanently records the winner of a completed weekly XP leaderboard. A row
// is written (idempotently, once per week) after that week has fully ended,
// so "top 1 when the week ended" becomes a lasting achievement.
model WeeklyFirst {
  id        String   @id @default(cuid())
  week      String   @unique // Monday YYYY-MM-DD — one winner per completed week
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  settledAt DateTime @default(now())

  @@index([userId])
}

// A notification shown in the header bell. localStorage is the primary store
// (works offline and for guests); this table is the server-side backup for
// signed-in users and the origin of server-generated notifications (feedback
// resolutions read from the real GitHub issue closing comment).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stable dedup key mirroring the local store's id (e.g. "badge:first-steps"
  // or "update:<slug>") so backup pushes and pulls are idempotent per user.
  localKey  String
  // "update" | "badge" | "feedback_received" | "feedback_closed"
  type      String
  title     String
  body      String?
  link      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([userId, localKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// Records the GitHub issue opened for a signed-in user's feedback, so a later
// close (with the author's real closing comment) can be relayed back to the
// reporter as a notification instead of auto-generated text.
model FeedbackTicket {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo          String
  issueNumber   Int
  title         String
  state         String    @default("open") // "open" | "closed"
  closedMessage String? // the real closing comment from the issue (if any)
  closedAt      DateTime?
  openedAt      DateTime  @default(now())

  @@unique([repo, issueNumber])
  @@index([userId, state])
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# opennext / cloudflare
/.open-next/
/.worker-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local wrangler dev secrets (never commit)
.dev.vars

# runtime artifacts
monitor.out
server.log
dev-server.log
*.log

# local verification scratch: build/dev logs, page captures, harnesses and
# generated narration samples (never part of the site)
cf-*-build.log
dev-start.cmd
.tmp-*/
.tmp-*
.verify-*
narration-samples/
/*.html

# local tool metadata (never part of the site)
.freebuff/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stray locked debug artifact
$log

.vercel
.env*

# android / capacitor wrapper
/mobile/node_modules/
/mobile/dist/
/mobile/android/.gradle/
/mobile/android/local.properties
/mobile/android/build/
/mobile/android/app/build/
/mobile/android/app/src/main/assets/public/
/RoCourse.apk

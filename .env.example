# Postgres connection string used by Prisma for the optional account system.
# Create a database (Vercel Postgres, Neon, etc.) and paste its connection string.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Direct (non-pooled) connection, used by Prisma for migrations when
# DATABASE_URL points at a connection pooler (e.g. Neon's -pooler host).
# Optional — omit if you're not using a pooler.
DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host:5432/database?sslmode=require"

# Secret used by Auth.js to sign JWT session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Required on hosted platforms (Vercel, Netlify). Leave unset for local dev.
AUTH_TRUST_HOST=true

# Optional: override the visible site name (header, sidebar, footer).
# NEXT_PUBLIC_COURSE_NAME="RoCourse"

# Analytics provider. Defaults to Vercel Analytics. Set "cloudflare" on the
# Cloudflare build to load the Cloudflare Web Analytics beacon instead, and
# provide the token from the Cloudflare dashboard. Bake-time vars: changing
# them requires a redeploy of the affected platform.
# NEXT_PUBLIC_ANALYTICS="vercel"
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=""

# Feedback button -> GitHub issues. Create a fine-grained personal access token
# with "Issues: read and write" on the feedback repo (github.com/settings/tokens),
# and set it as the server-only FEEDBACK_GITHUB_TOKEN on Vercel. The token and
# repo never reach the client. The same token also powers the community
# Resources feature (submissions are filed as issues in the same repo).
# FEEDBACK_GITHUB_REPO="hulkingburst/rocourse-feedback"
# FEEDBACK_GITHUB_TOKEN=""

# Resources / submissions. Create a Vercel Blob store in the Vercel dashboard
# (Storage -> Blob -> Create store). The store MUST use "Public" access — the
# app uploads with access "public" and serves download links to all visitors,
# so a Private store rejects every upload ("Cannot use public access on a
# private store"). Vercel adds BLOB_READ_WRITE_TOKEN to the project
# automatically; paste the same token into your local .env.local for local
# dev. Submissions are filed as issues in the repo below (defaults to the
# feedback repo) and published when you close an issue with the `accepted`
# label. Optional override:
# RESOURCES_GITHUB_REPO="hulkingburst/rocourse-feedback"

# Storage backend for resource zips. Leave unset (or "vercel") to keep using
# Vercel Blob with the token above. Set to "r2" to enable the Cloudflare R2
# path instead (requires ALL of the R2_* vars below). The R2 path is additive
# and stays dormant until FILE_STORAGE=r2 AND the credentials exist.
# FILE_STORAGE="vercel"

# Cloudflare R2 settings, used only when FILE_STORAGE=r2. R2_PUBLIC_HOST is the
# public bucket URL (a pub-*.r2.dev host or a custom domain) that submission
# download links are served from.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_HOST="pub-xxxxxxxxxxxxxxxxxxxx.r2.dev"

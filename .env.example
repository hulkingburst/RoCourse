# Postgres connection string used by Prisma for the optional account system.
# Create a database (Vercel Postgres, Neon, etc.) and paste its connection string.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Direct (non-pooled) connection, used by Prisma for migrations when
# DATABASE_URL points at a connection pooler (e.g. Neon's -pooler host).
# Optional — omit if you're not using a pooler.
DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host:5432/database?sslmode=require"

# Secret used by Auth.js to sign JWT session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Required on hosted platforms (Vercel, Netlify). Leave unset for local dev.
AUTH_TRUST_HOST=true

# Optional: override the visible site name (header, sidebar, footer).
# NEXT_PUBLIC_COURSE_NAME="RoCourse"
